{
  "name": "@forty-two/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx src/migrate-cli.ts",
    "pretest": "pnpm build",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "node --import tsx --test test/*.unit.test.ts",
    "test:integration": "node --env-file-if-exists=../../.env --import tsx --test test/*.int.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.5",
    "postgres": "^3.4.7",
    "ulid": "^2.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.13.3",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.23.12",
    "typescript": "5.9.3"
  }
}
