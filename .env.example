# Local Docker Compose defaults. Copy this file to .env only when overriding them.
POSTGRES_USER=forty_two
# Required: use a URL-safe value, for example the output of `openssl rand -hex 32`.
POSTGRES_PASSWORD=
# Required: an independent credential used only by the read-only datasource role.
POSTGRES_READER_PASSWORD=
# Independent Compose demo DML role; generate a URL-safe value.
POSTGRES_WRITER_PASSWORD=
# Dedicated controlled-mutation role. It owns only explicitly allowed demo tables.
POSTGRES_MUTATION_PASSWORD=
# Dedicated MCP control-plane reader; never reuse a target datasource role.
POSTGRES_MCP_PASSWORD=
POSTGRES_DB=forty_two
POSTGRES_PORT=5432

MYSQL_ROOT_PASSWORD=
MYSQL_READER_PASSWORD=
MYSQL_WRITER_PASSWORD=
MYSQL_PORT=3306

# SQL Server enforces its own password complexity rules for the SA password.
SQLSERVER_SA_PASSWORD=
SQLSERVER_READER_PASSWORD=
SQLSERVER_WRITER_PASSWORD=
SQLSERVER_PORT=1433

WEB_PORT=3000
# Explicit outbound resolver for containers that call Azure and other public APIs.
FORTY_TWO_DNS_SERVER=1.1.1.1
FORTY_TWO_AGENT_NAME=forty-two-data-agent
# Required platform sandbox image published to a registry Daytona can pull.
# Tags are rejected; use the immutable digest returned by the registry.
PLATFORM_SANDBOX_IMAGE_URI=
# Local-only build/test tag. Never use this mutable tag for Daytona registration.
FORTY_TWO_SANDBOX_LOCAL_IMAGE=forty-two-sandbox:local

# Required sandbox credential. The platform bootstrap stores it in TrueForge's
# settings database. The server-only web backend also uses it to delete Daytona
# sandboxes during session cleanup; it is never exposed to browser code.
DAYTONA_API_KEY=
# Optional Daytona control-plane base URL.
DAYTONA_API_URL=https://app.daytona.io/api

# Required model credential. The platform bootstrap configures TrueForge's
# shipped OpenAI model catalog with this key.
OPENAI_API_KEY=

# Required service-to-service token protecting the shared internal datasource
# /mcp endpoint and its internal control endpoints. Never expose it to browsers.
# Generate independently from the database password: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Required independent HMAC key for revocable browser ftart capabilities only.
# Generate separately: openssl rand -hex 32
MCP_CAPABILITY_SIGNING_KEY=
# Maximum immutable datasource bindings accepted by one chat session.
CHAT_SESSION_MAX_DATA_SOURCES=8
# Browser ftart capability lifetime in seconds (300-86400).
MCP_CAPABILITY_TTL_SECONDS=3600
# Required platform bearer token protecting the shared Todo MCP endpoint.
# Generate independently: openssl rand -hex 32
TODO_MCP_AUTH_TOKEN=
# Required independent 32-byte key, encoded as 64 hex characters or base64.
# Generate separately: openssl rand -hex 32
DATA_SOURCE_CREDENTIALS_ENCRYPTION_KEY=
# Comma-separated origins accepted by /mcp's security check. Browser CORS is
# intentionally unsupported; server-to-server requests normally omit Origin.
MCP_ALLOWED_ORIGINS=
# Accepted range is 1000-20000; Compose waits 25 seconds before hard kill.
DATA_SOURCE_MCP_SHUTDOWN_TIMEOUT_MS=15000
# Datasources exposed to product sessions are registered through the server-side
# datasource API and persisted under their public ds_ identifiers. The MCP does
# not load environment-defined static aliases.

# Durable datasource file storage. Keep the account key only in .env or the
# deployment secret manager; never expose it to NEXT_PUBLIC_* variables,
# TrueForge AgentSpec, API responses, or browser code.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=
# Comma-separated exact browser origins allowed to PUT directly to unique final
# blob SAS URLs. Wildcards are rejected.
AZURE_STORAGE_ALLOWED_ORIGINS=http://localhost:3000
# Forty Two resource policy (25 MiB by default), independent of TrueForge.
DATA_SOURCE_MAX_FILE_SIZE_BYTES=26214400
# Approval-gated mutation hard caps. BigQuery bytes are enforced at dry-run,
# revalidated before apply, and passed to the provider as maximumBytesBilled.
SQL_CHANGE_MAX_ROWS=100
SQL_CHANGE_MAX_BIGQUERY_BYTES_BILLED=1000000000
# Create-only upload SAS lifetime; accepted range is 60-900 seconds.
AZURE_STORAGE_UPLOAD_SAS_TTL_SECONDS=300

# Optional live-cloud test credentials. Suites explicitly skip unless every
# variable for that connector is present. These values remain server-side.
SNOWFLAKE_ACCOUNT_ID=
SNOWFLAKE_WAREHOUSE_ID=
SNOWFLAKE_DATABASE=
SNOWFLAKE_USERNAME=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_SQL_CHANGE_SCHEMA=
SNOWFLAKE_SQL_CHANGE_TABLE=
BIGQUERY_PROJECT_ID=
BIGQUERY_LOCATION=US
BIGQUERY_SERVICE_ACCOUNT_JSON=
BIGQUERY_SQL_CHANGE_DATASET=
BIGQUERY_SQL_CHANGE_TABLE=
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=
REDSHIFT_USERNAME=
REDSHIFT_PASSWORD=
REDSHIFT_SQL_CHANGE_SCHEMA=
REDSHIFT_SQL_CHANGE_TABLE=
