# Local Docker Compose defaults. Copy this file to .env only when overriding them.
POSTGRES_USER=forty_two
# Required: use a URL-safe value, for example the output of `openssl rand -hex 32`.
POSTGRES_PASSWORD=
POSTGRES_DB=forty_two
POSTGRES_PORT=5432

WEB_PORT=3000
TRUEFORGE_PORT=8790
TRUEFORGE_PUBLIC_BASE_URL=http://localhost:8790

# Required service-to-service token protecting the datasource MCP endpoint.
# Generate independently from the database password: openssl rand -hex 32
MCP_AUTH_TOKEN=
DATA_SOURCE_MCP_PORT=8791
# Comma-separated browser origins allowed to call /mcp. Requests without an
# Origin header (normal server-to-server calls) remain allowed.
MCP_ALLOWED_ORIGINS=
DATA_SOURCE_MCP_SHUTDOWN_TIMEOUT_MS=15000

# JSON array of server-side datasource definitions. Keep real credentials only
# in .env or a secret manager; never commit them. See apps/data-source-mcp/README.md.
DATA_SOURCE_CONNECTIONS_JSON=[]
