{
  "name": "forty-two",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test:agent-spec": "node scripts/test-agent-spec.mjs",
    "test:file-integration": "node scripts/test-file-integration.mjs",
    "test:platform-integration": "node scripts/test-platform-integration.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.11",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  }
}
