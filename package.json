{
  "name": "forty-two",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test:backend": "turbo run test --filter=web",
    "test:agent-spec": "node scripts/test-agent-spec.mjs",
    "test:integration-events": "node --test scripts/test-integration-events.mjs",
    "test:file-integration": "node scripts/run-compose-internal-e2e.mjs scripts/test-file-integration.mjs",
    "test:file-datasource-e2e": "node --env-file-if-exists=.env scripts/test-file-datasource-e2e.mjs",
    "test:database-datasource-e2e": "node scripts/run-compose-internal-e2e.mjs scripts/test-database-datasource-e2e.mjs",
    "test:combined-flow-contract": "node --test scripts/test-combined-flow-contract.mjs",
    "test:chat-backend-e2e": "node scripts/run-compose-internal-e2e.mjs scripts/test-chat-backend-e2e.mjs",
    "test:frontend-client": "pnpm --filter @repo/charting build && node --test scripts/test-frontend-client-contract.mjs && node scripts/run-frontend-client-e2e.mjs",
    "test:web-production-image": "node scripts/test-web-production-image.mjs",
    "test:chat-backend-soak": "node scripts/run-chat-backend-soak.mjs",
    "test:platform-integration": "node scripts/run-compose-internal-e2e.mjs scripts/test-platform-integration.mjs",
    "test:plan-e2e": "node scripts/run-compose-internal-e2e.mjs scripts/test-plan-e2e.mjs",
    "test:control-plane-isolation": "node --env-file-if-exists=.env scripts/test-control-plane-isolation-e2e.mjs",
    "test:artifact-backend-e2e": "node scripts/run-compose-internal-e2e.mjs scripts/test-artifact-backend-e2e.mjs",
    "test:sql-change-approval-e2e": "node scripts/run-compose-internal-e2e.mjs scripts/test-sql-change-approval-e2e.mjs",
    "test:artifact-helper-python": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s packages/artifacts/python/tests -p 'test_*.py' -v",
    "test:artifact-helper-acceptance": "node --test scripts/test-artifact-helper-acceptance.mjs",
    "build:sandbox-image": "docker build --file docker/sandbox/Dockerfile --tag forty-two-sandbox:local .",
    "test:sandbox-image": "node scripts/test-sandbox-image.mjs",
    "test:artifact-helper-daytona-e2e": "node scripts/run-compose-internal-e2e.mjs scripts/test-artifact-helper-daytona-e2e.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.11",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  }
}
