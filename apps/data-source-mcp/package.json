{
  "name": "@forty-two/data-source-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint . --max-warnings 0",
    "pretest": "pnpm --filter @forty-two/db build && pnpm --filter @forty-two/data-source build",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:image": "bash test/image-sigterm.sh"
  },
  "dependencies": {
    "@forty-two/data-source": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^4.4.3",
    "@forty-two/db": "workspace:*"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.1",
    "tsx": "^4.23.12"
  }
}
